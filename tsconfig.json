{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "strict": true,
        "moduleResolution": "bundler",
        "types": ["node"],
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*", "*.ts"]
}
